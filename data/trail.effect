uniform float4x4 ViewProj;
uniform texture2d image;
uniform float opacity;

sampler_state trail_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct TrailVertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

TrailVertInOut VSTrail(TrailVertInOut vert_in)
{
	TrailVertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float4 PSDrawTrail(TrailVertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(trail_sampler, vert_in.uv);
	rgba.rgb *= opacity;
	rgba.a *= opacity;
	return rgba;
}

technique DrawTrail
{
	pass
	{
		vertex_shader = VSTrail(vert_in);
		pixel_shader  = PSDrawTrail(vert_in);
	}
}