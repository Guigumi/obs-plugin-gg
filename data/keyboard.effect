uniform float4x4 ViewProj;
uniform texture2d image;
uniform float opacity;
uniform float4 tint;
uniform float corner_radius;

sampler_state keyboard_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct KeyboardVertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

KeyboardVertInOut VSKeyboard(KeyboardVertInOut vert_in)
{
	KeyboardVertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float4 PSDrawKeyboard(KeyboardVertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(keyboard_sampler, vert_in.uv);
	float luminance = dot(rgba.rgb, float3(0.2126, 0.7152, 0.0722));
	rgba.rgb = tint.rgb * luminance;
	rgba.rgb *= rgba.a * opacity;
	rgba.a *= opacity;
	return rgba;
}

float4 PSDrawKeyboardCircle(KeyboardVertInOut vert_in) : TARGET
{
	float2 centered = vert_in.uv - 0.5f;
	float radius = length(centered) / 0.5f;
	float alpha = 1.0f - smoothstep(0.35f, 1.0f, radius);
	alpha *= opacity;
	return float4(tint.rgb * alpha, alpha);
}

float4 PSDrawKeyboardBorder(KeyboardVertInOut vert_in) : TARGET
{
	float2 centered = vert_in.uv - 0.5f;
	float corner = 0.16f;
	float thickness = 0.045f;
	float2 q = abs(centered) - (0.5f - corner);
	float outside = max(q, 0.0f);
	float distance = length(outside) + min(max(q.x, q.y), 0.0f) - corner;
	float alpha = 1.0f - smoothstep(0.0f, thickness, abs(distance));
	alpha *= opacity;
	return float4(tint.rgb * alpha, alpha);
}

float4 PSDrawKeyboardProcedural(KeyboardVertInOut vert_in) : TARGET
{
	float2 centered = vert_in.uv - 0.5f;
	float corner = min(max(corner_radius, 0.0f), 0.28f);
	float2 q = abs(centered) - (0.5f - corner);
	float outside = max(q, 0.0f);
	float signed_distance = length(outside) + min(max(q.x, q.y), 0.0f) - corner;
	float alpha = 1.0f - smoothstep(0.0f, 0.015f, signed_distance);
	alpha *= opacity;
	float top_light = 0.86f + 0.18f * (1.0f - vert_in.uv.y);
	float center_light = 0.96f + 0.04f * (1.0f - abs(centered.x) * 2.0f);
	return float4(tint.rgb * top_light * center_light * alpha, alpha);
}

technique DrawKeyboard
{
	pass
	{
		vertex_shader = VSKeyboard(vert_in);
		pixel_shader  = PSDrawKeyboard(vert_in);
	}
}

technique DrawKeyboardCircle
{
	pass
	{
		vertex_shader = VSKeyboard(vert_in);
		pixel_shader  = PSDrawKeyboardCircle(vert_in);
	}
}

technique DrawKeyboardBorder
{
	pass
	{
		vertex_shader = VSKeyboard(vert_in);
		pixel_shader  = PSDrawKeyboardBorder(vert_in);
	}
}

technique DrawKeyboardProcedural
{
	pass
	{
		vertex_shader = VSKeyboard(vert_in);
		pixel_shader  = PSDrawKeyboardProcedural(vert_in);
	}
}
